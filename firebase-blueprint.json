{
  "entities": {
    "workshopSettings": {
      "title": "WorkshopSettings",
      "description": "Workshop configuration, identity, and pricing defaults",
      "type": "object",
      "properties": {
        "workshopName": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "currency": { "type": "string" },
        "defaultUnit": { "type": "string" },
        "taxRate": { "type": "number" },
        "taxNumber": { "type": "string" }
      },
      "required": ["workshopName", "currency"]
    },
    "customerOrder": {
      "title": "CustomerOrder",
      "description": "Customer sales invoice with itemized custom sizing and settlement",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "subtotalPrice": { "type": "number" },
        "finalSellingPrice": { "type": "number" },
        "deposit": { "type": "number" },
        "remainingBalance": { "type": "number" }
      },
      "required": ["id", "customerName", "finalSellingPrice"]
    },
    "supplierPurchaseInvoice": {
      "title": "SupplierPurchaseInvoice",
      "description": "Supplier raw material purchase invoice",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "supplierName": { "type": "string" },
        "invoiceDate": { "type": "string" },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "paymentStatus": { "type": "string" }
      },
      "required": ["id", "supplierName", "totalAmount"]
    },
    "workshopExpense": {
      "title": "WorkshopExpense",
      "description": "Operating expense for workshop",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "title", "amount"]
    }
  },
  "firestore": {
    "/workshop_settings/{settingId}": {
      "schema": "workshopSettings",
      "description": "Stores shop profile and default pricing"
    },
    "/customer_orders/{orderId}": {
      "schema": "customerOrder",
      "description": "Stores customer sales orders and dimensions"
    },
    "/supplier_invoices/{invoiceId}": {
      "schema": "supplierPurchaseInvoice",
      "description": "Stores raw material supplier invoices"
    },
    "/workshop_expenses/{expenseId}": {
      "schema": "workshopExpense",
      "description": "Stores workshop operational expenses"
    }
  }
}
