rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /workshop_settings/{settingId} {
      allow read, write: if true;
    }
    match /customer_orders/{orderId} {
      allow read, write: if true;
    }
    match /supplier_invoices/{invoiceId} {
      allow read, write: if true;
    }
    match /workshop_expenses/{expenseId} {
      allow read, write: if true;
    }
    match /test/{testId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
